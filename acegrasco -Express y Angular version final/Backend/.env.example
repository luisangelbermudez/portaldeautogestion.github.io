# Copia este archivo como ".env" y ajusta los valores segun tu entorno (XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=portal_acegrasco
# Solo para bases en la nube (Aiven, TiDB Cloud...): activar SSL y, si el proveedor lo entrega, pegar el certificado CA en una sola linea (con \n)
DB_SSL=false
DB_SSL_CA=
PORT=3000

# Clave para firmar las sesiones (JWT). Usa un texto largo y aleatorio. NO la compartas.
JWT_SECRET=cambia_esta_clave_por_un_texto_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# Origen(es) del frontend permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:4200

# Envio real de certificados por correo (SMTP). Si SMTP_HOST se deja vacio, la opcion
# "Enviar por correo" responde que el envio no esta configurado (no finge enviarlo).
# Ejemplo con Gmail: activar verificacion en 2 pasos y crear una "contrasena de aplicacion".
# Render (plan gratis) BLOQUEA los puertos 25, 465 y 587: alli usa Mailtrap (puerto 2525).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Acegrasco S.A. <rrhh@acegrasco.com>"
