  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Login administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"jltrivino@acegrasco.com\",\n  \"contrasena\": \"123456\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test('Devuelve token', () => pm.expect(d.token).to.be.a('string'));",
                  "pm.collectionVariables.set('tokenAdmin', d.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login empleado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"gsilvana@acegrasco.com\",\n  \"contrasena\": \"123456\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.collectionVariables.set('tokenEmpleado', d.token);",
                  "pm.collectionVariables.set('idUsuarioEmpleado', d.usuario.idUsuario);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con contraseña incorrecta",
