              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actual\": \"123456\",\n  \"nueva\": \"nuevaClave1\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Volver a la contraseña original (123456)",
