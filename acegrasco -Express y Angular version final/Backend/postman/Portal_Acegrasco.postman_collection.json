{
  "info": {
    "name": "Portal de Autogestión Acegrasco - API",
    "description": "Pruebas de la API del portal. Orden: ejecutar la carpeta 1 primero (guarda los tokens) y luego las demás. Requiere el backend encendido y la base con los usuarios de ejemplo (clave 123456).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "tokenEmpleado",
      "value": ""
    },
    {
      "key": "idUsuarioEmpleado",
      "value": ""
    },
    {
      "key": "idEmpleado",
      "value": ""
    },
    {
      "key": "idSolicitud",
      "value": ""
    }
